{
	"schemaVersion": 1,
	"id": "forcemaster_rpg",
	"version": "${version}",
	"name": "Forcemaster",
	"description": "Grab a Knuckle, master the force and martial art. Spell Engine Add-On",
	"authors": [
		"Fichte"
	],
	"contributors": [
		"Slepykat (Artist)",
		"HaxTheCharizard (Artist)"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/forcemaster-rpg-class",
		"sources": "https://github.com/ProfessorFichte/Forcemaster",
		"issues": "https://github.com/ProfessorFichte/Forcemaster/issues",
		"artist1_contact": "https://slepykat.carrd.co/"
	},
	"license": "ARR",
	"icon": "assets/forcemaster_rpg/icon.png",
	"environment": "*",
	"entrypoints": {
		"client": [
			"com.forcemaster.fabric.client.FabricClient"
		],
		"main": [
			"com.forcemaster.fabric.FabricMod"
		],
		"fabric-datagen": [
			"net.forcemaster_rpg.ForcemasterClassModDataGenerator"
		]
	},
	"mixins": [
		"forcemaster-class-mod.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${fabric_loader_compat_version}",
