		"java": ">=21",
		"fabric-api": "*",
		"armor_model_api": ">=${armor_model_api_version}",
		"spell_engine": ">=${spell_engine_version}",
		"spell_power": ">=${spell_power_version}",
		"mrpg_lib": ">=${more_rpg_library_version}"
	},
	"suggests": {
		"bettercombat": "*",
		"armory_rpgs": "*",
		"arsenal": "*",
		"mrpgc_skill_tree": "*"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.discord": "https://discord.gg/AShKd5XrTu",
				"modmenu.kofi": "https://ko-fi.com/fichteee",
				"modmenu.modrinth": "https://modrinth.com/mod/forcemaster-rpg-class",
				"modmenu.curseforge": "https://www.curseforge.com/minecraft/mc-mods/forcemaster-rpg-class"
			}
		}
	}
}